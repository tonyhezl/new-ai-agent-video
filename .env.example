# 织影 LoomFrame：复制为 .env 后，设置自己的密码和服务配置。
COMPOSE_PROJECT_NAME=loomframe
APP_IMAGE_TAG=local
# 默认只监听本机；服务器通过 HTTPS 反向代理访问。
APP_BIND_HOST=127.0.0.1
APP_PORT=8080

# 必须替换两个示例密码；建议使用不同的随机密码。
MYSQL_ROOT_PASSWORD='replace-with-your-mysql-password'
MYSQL_DATABASE=ai-agent-video
REDIS_PASSWORD='replace-with-your-redis-password'

# 仅本机源码开发模式使用的数据库映射端口。
DEV_MYSQL_PORT=43306
DEV_REDIS_PORT=46379

# 可先启动平台，再在管理界面配置自己的模型接口。
AI_DASHSCOPE_API_KEY=sk-placeholder
APP_CORS_ALLOWED_ORIGIN_PATTERNS='http://localhost:*,http://127.0.0.1:*'
JAVA_TOOL_OPTIONS='-Xms512m -Xmx1024m'

# 交付版默认使用本地构建版本，不访问外部发布仓库。
APP_VERSION_CHECK_ENABLED=false
# 如自行建立发布渠道，可按部署文档启用并填写以下配置。
APP_VERSION_CHECK_RELEASES_API_URL=
APP_VERSION_CHECK_RELEASES_PAGE_URL=
APP_VERSION_CHECK_BACKEND_IMAGE_REPOSITORY=
APP_VERSION_CHECK_FRONTEND_IMAGE_REPOSITORY=
